{
  "id": "what-next",
  "version": 1,
  "trigger": { "on": "board.idle" },
  "nodes": [
    { "id": "digest", "kind": "check", "run": "office:digest", "out": "digest",
      "next": { "pass": "decide", "skip": "end" } },
    { "id": "decide", "kind": "decide", "run": "office:what-next", "needs": ["plan"],
      "in": ["digest"], "out": "decision",
      "done": [{ "ru": "По направлению выводится фича — предложи её одним вызовом", "en": "A feature follows from the direction — propose it with one call" },
               { "ru": "Фичу не вывести, а направление стоит обсудить — созови совещание", "en": "No feature follows, but the direction is worth discussing — call a meeting" },
               { "ru": "Делать нечего — так и скажи", "en": "Nothing to do — say so" }],
      "next": { "feature": "end", "meet": "agenda", "nothing": "end" } },
    { "id": "agenda", "kind": "check", "run": "office:agenda", "in": ["digest", "decision"], "out": "agenda",
      "next": { "pass": "meeting", "skip": "end" } },
    { "id": "meeting", "kind": "meeting", "in": ["agenda"], "out": "transcript",
      "limits": { "turns": 6 },
      "next": { "done": "summary", "failed": "stuck" } },
    { "id": "summary", "kind": "decide", "run": "office:meeting-summary", "needs": ["summarize"],
      "in": ["agenda", "transcript"], "out": "proposals",
      "done": [{ "ru": "Не больше трёх предложений", "en": "No more than three proposals" }, { "ru": "У каждого — направление и обоснование", "en": "Each has a direction and a rationale" },
               { "ru": "Отклонённое раньше не предлагать снова", "en": "Do not propose again what was rejected before" }],
      "next": { "proposed": "end", "nothing": "end" } }
  ]
}
