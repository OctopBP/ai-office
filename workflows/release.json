{
  "id": "release",
  "version": 1,
  "trigger": { "on": "release.due" },
  "nodes": [
    { "id": "snapshot", "kind": "check", "run": "office:release-snapshot", "out": "snapshot",
      "next": { "pass": "version", "empty": "end", "fail": "stuck" } },
    { "id": "version", "kind": "check", "run": "office:release-version", "out": "version",
      "next": { "pass": "notes", "fail": "stuck" } },
    { "id": "notes", "kind": "step", "run": "office:release-notes", "needs": ["summarize"],
      "in": ["snapshot"], "out": "notes", "limits": { "turns": 2 },
      "done": ["Заметки о выпуске — по делу, без внутренних деталей"],
      "next": { "done": "approve" } },
    { "id": "approve", "kind": "gate", "run": "office:release-approve", "in": ["version", "notes"], "out": "decision",
      "done": ["Владелец согласился на выпуск"],
      "next": { "yes": "bump", "no": "end" } },
    { "id": "bump", "kind": "check", "run": "office:release-bump",
      "next": { "pass": "ship", "fail": "stuck" } },
    { "id": "ship", "kind": "decide", "run": "office:release-kind",
      "next": { "push": "push", "tag": "tag", "command": "build" } },
    { "id": "push", "kind": "check", "run": "office:release-push", "out": "shipped",
      "next": { "pass": "watch", "fail": "stuck" } },
    { "id": "tag", "kind": "check", "run": "office:release-tag", "out": "shipped",
      "next": { "pass": "watch", "fail": "stuck" } },
    { "id": "watch", "kind": "check", "run": "office:ci-watch", "out": "result",
      "next": { "pass": "publish", "fail": { "to": "fix", "max": 1 } } },
    { "id": "build", "kind": "check", "run": "office:release-build", "out": "result",
      "next": { "pass": "publish", "fail": { "to": "fix", "max": 1 } } },
    { "id": "fix", "kind": "step", "run": "office:fix-build", "needs": ["code.write"], "in": ["result"],
      "done": ["Сборка чинится в ветке от выпуска", "Починка прошла ревью и влита в ветку выпуска"],
      "next": { "done": "ship", "failed": "stuck" } },
    { "id": "publish", "kind": "check", "run": "office:release-publish",
      "next": { "pass": "end" } }
  ]
}
