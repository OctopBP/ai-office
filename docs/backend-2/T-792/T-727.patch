+async function управляющий<T>(run: (server: Awaited<ReturnType<typeof startServer>>) => Promise<T>, auth: Record<string, string> = {}): Promise<T> {
+  const dir = mkdtempSync(resolve(tmpdir(), 'office-opencode-'));
+  const abort = new AbortController();
+  let server: Awaited<ReturnType<typeof startServer>> | undefined;
+  try {
+    // Никаких ключей в окружении: только явно переданная авторизация в памяти процесса.
+    const config = { autoupdate: false, share: 'disabled', snapshot: false, plugin: [], mcp: {}, tools: { '*': false }, permission: { '*': 'deny' },
+      provider: Object.fromEntries(Object.entries(auth).map(([id, apiKey]) => [id, { options: { apiKey } }])) };
+    server = await startServer(dir, opencodeEnv({ OPENCODE_CONFIG_CONTENT: JSON.stringify(config) }, dir), abort.signal);
+    return await run(server);
+  } catch (e) {
+    if (e instanceof ОшибкаOpenCode) throw e;
+    throw new ОшибкаOpenCode(502, 'upstream', 'Не удалось получить метаданные OpenCode');
+  } finally { server?.close(); abort.abort(); rmSync(dir, { recursive: true, force: true }); }
+}
+export async function каталогOpenCode(версия: string, force = false): Promise<Снимок> {
+  if (!force && снимок && снимок.dto.версия === версия && Date.now() - снимок.dto.обновлёнВ < TTL) return снимок;
+  if (загрузка) return загрузка;
+  загрузка = (async () => {
+    const auth: Record<string, string> = {};
+    for (const id of подключения().провайдеры) { const k = await ключ(id); if (k) auth[id] = k; }
+    try {
+      снимок = await управляющий(async server => {
+        const raw = await server.request<Сырой>('GET', '/provider');
+        return каталогDTO(raw, версия, auth);
+      }, auth);
+      return снимок;
+    } catch (e) {
+      if (снимок && снимок.dto.версия === версия) { снимок.dto.устарел = true; return снимок; }
+      throw e;
+    }
+  })();
+  try { return await загрузка; } finally { загрузка = undefined; }
+}
+export function проверитьВыбор(выбор: ModelChoice, snapshot: Снимок, ревизия?: string): ModelChoice {
+  if (ревизия !== undefined && ревизия !== snapshot.dto.ревизия) throw new ОшибкаOpenCode(409, 'catalog-changed', 'Каталог изменился; обновите описание модели');
+  if (выбор.provider !== 'opencode') ошибка('Ожидается провайдер opencode', 'provider');
+  const m = snapshot.dto.провайдеры.flatMap(p => p.модели).find(m => m.id === выбор.model);
+  if (!m || !m.opencode.доступна) ошибка(m?.opencode.причина ?? 'Сохранённая модель отсутствует в каталоге', 'model');
+  let параметры;
+  try { параметры = проверитьФормуOpenCode(выбор.opencode ?? {}); } catch (e) { ошибка((e as Error).message, 'opencode'); }
+  const meta = m!.opencode;
+  if (параметры!.вариант !== undefined && !meta.варианты.includes(параметры!.вариант)) ошибка('Вариант не поддерживается моделью', 'opencode.вариант');
+  if (параметры!.температура !== undefined && (!meta.температура || параметры!.температура > meta.температура.макс)) ошибка('Температура не поддерживается моделью', 'opencode.температура');
+  if (параметры!.пределОтвета !== undefined && (!meta.пределОтвета || параметры!.пределОтвета > meta.пределОтвета.макс)) ошибка('Предел ответа не поддерживается моделью', 'opencode.пределОтвета');
