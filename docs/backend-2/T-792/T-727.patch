+}
+/** Синхронная запись настроек проверяется по снимку, полученному формой validate. */
+export function проверитьСохранениеOpenCode(выбор: ModelChoice): ModelChoice {
+  if (!снимок || снимок.dto.устарел || Date.now() - снимок.dto.обновлёнВ >= TTL) throw new ОшибкаOpenCode(409, 'catalog-required', 'Обновите каталог OpenCode перед сохранением');
+  return проверитьВыбор(выбор, снимок);
+}
+export async function авторизоватьOpenCode(id: unknown, secret: unknown, версия: string): Promise<void> {
+  if (typeof id !== 'string' || !Object.hasOwn(SDK, id)) ошибка('Неподдерживаемый поставщик', 'провайдер');
+  if (typeof secret !== 'string' || !secret.trim() || /\s/.test(secret)) ошибка('Нужен непустой ключ API', 'apiKey');
+  if (версия !== OPENCODE_VERSION) throw new ОшибкаOpenCode(503, 'incompatible-version', 'Версия OpenCode не проверена');
+  if (!await keychainAvailable()) throw new ОшибкаOpenCode(503, 'keychain', 'Системная связка ключей недоступна');
+  const snap = await управляющий(async server => каталогDTO(await server.request<Сырой>('GET', '/provider'), версия, { [id as string]: secret as string }), { [id as string]: secret as string });
+  if (!snap.dto.провайдеры.some(p => p.id === id && p.доступен)) ошибка('Поставщик не поддерживается установленным движком', 'провайдер');
+  // Каталог подтверждает конфигурацию, но не совершает платного запроса и не доказывает валидность ключа.
+  await keychain.set(учётка(id as string), (secret as string).trim());
+  сохранить([...new Set([...подключения().провайдеры, id as string])]);
+}
+export async function отключитьOpenCode(id: unknown): Promise<void> {
+  if (typeof id !== 'string' || !Object.hasOwn(SDK, id)) ошибка('Укажите поставщика для выхода', 'провайдер');
+  await keychain.delete(учётка(id as string));
+  сохранить(подключения().провайдеры.filter(p => p !== id));
+}
+export async function разрешитьOpenCode(выбор: ModelChoice, версия: string) {
+  if (версия !== OPENCODE_VERSION) throw new ОшибкаOpenCode(503, 'incompatible-version', 'Версия OpenCode не проверена');
+  const snapshot = await каталогOpenCode(версия);
+  if (snapshot.dto.устарел) throw new ОшибкаOpenCode(502, 'stale-catalog', 'Каталог OpenCode устарел');
+  const clean = проверитьВыбор(выбор, snapshot);
+  const info = snapshot.dto.провайдеры.flatMap(p => p.модели).find(m => m.id === clean.model)!;
+  return { выбор: clean, info, raw: snapshot.модели.get(clean.model)!, ключ: await ключ(info.opencode.провайдер) };
+}
+export function моделиКаталога(snapshot: Снимок): ModelInfo[] {
+  return snapshot.dto.провайдеры.flatMap(p => p.модели).filter(m => m.opencode.доступна);
+}
+/** Новая ветка сохраняет настоящий SDK и меняет только проверенные поля. */
+export function нативныйКонфиг(resolved: Awaited<ReturnType<typeof разрешитьOpenCode>>, system: string, bridge: { url: string; authorization: string }): Record<string, any> {
+  const { выбор, info, raw } = resolved;
+  const { провайдер, модель } = info.opencode;
+  const config: any = buildConfig({ provider: 'opencode', baseUrl: '', model: модель, system, bridge });
+  config.enabled_providers = [провайдер];
+  config.model = config.small_model = выбор.model;
+  config.plugin = [];
+  config.provider = { [провайдер]: { options: { ...(resolved.ключ ? { apiKey: resolved.ключ } : {}), timeout: false },
+    models: { [модель]: { ...(выбор.opencode?.пределОтвета !== undefined ? { limit: {
+      context: raw.limit.context, ...(raw.limit.input !== undefined ? { input: raw.limit.input } : {}), output: выбор.opencode.пределОтвета } } : {}) } } } };
+  config.agent.office.temperature = выбор.opencode?.температура;
+  config.permission = { '*': 'deny', ...config.permission };
+  config.agent.office.permission = { '*': 'deny', ...config.agent.office.permission };
+  return config;
+}
+/** После слияния конфигов движком проверяем права и полный список нативных инструментов. */
+export async function проверитьИзоляциюOpenCode(server: Awaited<ReturnType<typeof startServer>>, native: string): Promise<void> {
+  const config = await server.request<Сырой>('GET', '/config');
+  if (JSON.stringify(config.enabled_providers) !== JSON.stringify([native]) || Object.keys(config.mcp ?? {}).some(k => k !== 'office')
+    || (config.plugin ?? []).length || config.instructions?.length || config.agent?.office?.permission?.['*'] !== 'deny') {
+    throw new ОшибкаOpenCode(503, 'unsafe-config', 'Движок добавил неподтверждённую конфигурацию');
+  }
+  const ids = await server.request<string[]>('GET', '/tool/ids');
+  for (const id of ids) {
+    if (id.startsWith('office_')) continue;
+    if (!NATIVE_TOOLS.includes(id) || config.tools?.[id] !== false || config.agent?.office?.tools?.[id] !== false) {
+      throw new ОшибкаOpenCode(503, 'unsafe-tools', 'Обнаружен неподтверждённый инструмент движка');
+    }
+  }
+}
