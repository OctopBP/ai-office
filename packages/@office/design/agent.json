{
  "schema": 1,
  "name": "@office/design",
  "kind": "agent",
  "title": {
    "ru": "UI/UX дизайнер",
    "en": "UI/UX designer"
  },
  "summary": {
    "ru": "Интерфейс и пользовательский опыт: экраны, состояния, тексты; канвас макетов и Figma через мост.",
    "en": "UI/UX designer: screens, states, interface copy; design canvases and Figma through the bridge."
  },
  "tags": [
    "design",
    "ui",
    "figma",
    "penpot"
  ],
  "color": "#a855f7",
  "emoji": "🎨",
  "docsDir": "docs/design",
  "license": "MIT",
  "capabilities": [
    "design.ui"
  ],
  "runtime": {
    "engine": "claude-code",
    "model": "sonnet",
    "tools": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Bash",
      "WebSearch",
      "WebFetch",
      "TodoWrite",
      "Artifact"
    ],
    "permissionMode": "ask-risky",
    "isolate": true,
    "maxTurns": null,
    "mcp": [
      "figma-bridge",
      "figma-console",
      "penpot"
    ]
  },
  "builtin": [
    "design",
    "artifact-capabilities"
  ],
  "servers": [
    {
      "id": "figma-bridge",
      "title": "Figma",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@gethopp/figma-mcp-bridge"
      ],
      "alwaysLoad": true
    },
    {
      "id": "figma-console",
      "title": "Figma Console",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "figma-console-mcp@1.40.9"
      ],
      "env": {
        "FIGMA_ACCESS_TOKEN": "${FIGMA_ACCESS_TOKEN}"
      },
      "alwaysLoad": true
    },
    {
      "id": "penpot",
      "title": "Penpot",
      "transport": "http",
      "url": "http://localhost:4401/mcp",
      "alwaysLoad": true
    }
  ]
}
