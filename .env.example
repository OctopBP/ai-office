# Переменные окружения офиса. Скопируйте в .env (он в .gitignore) или задайте
# в оболочке. Все необязательны: без них офис поднимается с умолчаниями.

# ---- Доступ к Claude ---------------------------------------------------------
# Без ключа SDK работает на авторизации Claude Code (команда `claude`, /login),
# и расход идёт в лимиты подписки. Ключ имеет приоритет и переключает офис на
# платный API — индикатор в шапке покажет 💳 вместо 🔑.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_AUTH_TOKEN=

# ---- Сервер ------------------------------------------------------------------
# Порт WebSocket-сервера и собранного веба (npm run office).
# OFFICE_PORT=3001
# Директория, в которой работает команда. По умолчанию отдельная папка внутри
# репозитория, чтобы агенты не правили исходники самого офиса.
# OFFICE_PROJECT_DIR=./workspace
# Файл состояния: доска, лента, настройки офисов.
# OFFICE_STATE_FILE=.office/state.json
# Язык, на котором заводится новый офис: en или ru. У заведённого язык свой.
# OFFICE_LANG=en
# Сколько исполнителей работают одновременно во всём процессе.
# OFFICE_MAX_WORKERS=6

# ---- Облачный режим ----------------------------------------------------------
# Токен GitHub для облачных исполнителей. Без него вводится в настройках и
# живёт только до перезапуска сервера.
# OFFICE_GITHUB_TOKEN=

# ---- Пакеты ролей и маркет ---------------------------------------------------
# Откуда брать индекс маркета: путь к файлу или URL. По умолчанию
# registry/registry.json из репозитория.
# OFFICE_REGISTRY=
# Кеш установленных пакетов: один пакет может стоять в десяти офисах.
# OFFICE_PACKAGE_CACHE=~/.office/packages
# Папка встроенных пакетов (по умолчанию packages/ в репозитории).
# OFFICE_PACKAGES_DIR=
# Папка наборов навыков сотрудников (по умолчанию employees/ в репозитории).
# OFFICE_EMPLOYEES_DIR=

# ---- Внешние сервисы ролей ---------------------------------------------------
# Ключ генератора картинок для роли «Иллюстратор».
# NANOBANANA_API_KEY=
# Токен для публикации пакета в реестр из CLI (npm run office-agent -- publish).
# GITHUB_TOKEN=

# ---- Сервис реестра (npm run registry) ---------------------------------------
# OFFICE_REGISTRY_ADMIN_TOKEN=
# OFFICE_REGISTRY_GITHUB_API=

# ---- Только для тестов и отладки ---------------------------------------------
# Заглушить исполнителей: задачи «выполняются» по таймеру, токены тратит только
# менеджер. Так гоняются регрессионные тесты PM.
# OFFICE_DRY_RUN=1
# OFFICE_DRY_RUN_DELAY=250
# Живые проверки, которые ходят в SDK: MCP_LIVE=1 npm run test:mcp,
# SKILLS_LIVE=1 npm run test:skills.
# MCP_LIVE=1
# SKILLS_LIVE=1
