node_modules
dist/
.office/
.env
workspace/
.figma-preview/

# Мусор от прогонов в рабочих копиях исполнителей.
# .tmp-test/ — сюда node складывает свой compile-cache, когда песочница
# закрывает системный TMPDIR; каталог уже уезжал в ветку задачи.
.tmp-test/
# .tmp/ — черновики и логи ручных прогонов (например Blender), не для коммита.
.tmp/
# __pycache__/ — байт-код генераторов спрайтов из design/sprites.
__pycache__/
# Резервные копии Blender — он кладёт их рядом с .blend при каждом сохранении.
*.blend1

# Служебные файлы Finder.
.DS_Store

# Приложение: ресурсы и установщики собираются, в репозитории их нет
desktop/node_modules/
desktop/resources/
desktop/out/
