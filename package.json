{
  "name": "ai-office",
  "version": "0.13.0-beta.2",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:3d": "concurrently -n server,web -c cyan,magenta \"OFFICE_PORT=3002 OFFICE_STATE_FILE=.office/state-3d.json tsx watch src/server/index.ts\" \"VITE_OFFICE_PORT=3002 vite --port 5174 --strictPort\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "build:desktop": "npm run build && node scripts/pack-desktop.mjs",
    "desktop": "npm run build:desktop && npm --prefix desktop start",
    "desktop:dist": "npm run build:desktop && npm --prefix desktop run dist",
    "office": "bash scripts/office.sh",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "probe": "tsx scripts/probe.ts",
    "scene": "bash scripts/scene.sh",
    "model": "bash scripts/model.sh",
    "scene:check": "python3 tools/blender/inspect_glb.py",
    "units": "python3 scripts/units.py",
    "test:perm": "tsx scripts/test-permissions.ts",
    "test:providers": "node --import tsx scripts/test-providers.ts",
    "test:secrets": "node --import tsx scripts/test-secrets.ts",
    "test:skills": "tsx scripts/test-skills.ts",
    "test:packages": "tsx scripts/test-packages.ts",
    "test:market": "tsx scripts/test-market.ts",
    "test:mcp": "tsx scripts/test-mcp.ts",
    "test:looks": "tsx scripts/test-looks.ts",
    "test:contrast": "tsx scripts/check-contrast.ts",
    "test:imagegen": "tsx scripts/test-imagegen.ts",
    "test:packtools": "node scripts/test-pack-tools.mjs",
    "bench": "tsx scripts/bench-skills.ts",
    "office-agent": "tsx src/cli/office-agent.ts",
    "registry": "tsx src/registry/main.ts",
    "test:registry": "tsx scripts/test-registry.ts",
    "test:cli": "tsx scripts/test-cli.ts",
    "test:state": "tsx scripts/test-state.ts",
    "test:nav": "tsx scripts/test-nav.ts",
    "test:reach": "tsx scripts/check-reachability.ts",
    "test:plan": "tsx scripts/test-plan.ts",
    "test:tasks": "tsx scripts/test-tasks.ts",
    "test:taskview": "node --import tsx/esm scripts/test-task-view.ts",
    "premerge": "tsx scripts/premerge.ts",
    "test:merge": "tsx scripts/test-merge.ts",
    "test:premerge": "tsx scripts/test-premerge.ts",
    "test:deps": "node --import tsx/esm scripts/test-deps.ts",
    "test:overlap": "tsx scripts/test-overlap.ts",
    "test:layout": "node --import tsx/esm scripts/test-layout.ts",
    "test:boardview": "node --import tsx/esm scripts/test-board-view.ts",
    "test:squash": "tsx scripts/test-squash.ts",
    "test:taskfiles": "tsx scripts/test-taskfiles.ts",
    "test:money": "tsx scripts/test-money.ts",
    "test:spendreport": "tsx scripts/test-spend-report.ts",
    "test:runguard": "node --import tsx scripts/test-runguard.ts",
    "test:busy": "node --import tsx scripts/test-busy.ts",
    "test:rules": "tsx scripts/test-rules.ts",
    "test:subprojects": "node --import tsx scripts/test-subprojects.ts",
    "test:zone-write": "node --import tsx scripts/test-zone-write.ts",
    "test:life": "tsx scripts/test-life.ts",
    "test:journal": "node --import tsx scripts/test-journal-superseded.ts",
    "import:docs": "node --import tsx scripts/import-docs.ts",
    "test:docs": "node --import tsx scripts/test-docs.ts",
    "test:docstools": "node --import tsx scripts/test-docs-tools.ts",
    "test:docs-api": "node --import tsx scripts/test-docs-api.ts",
    "test:contradictions": "node --import tsx scripts/test-contradictions.ts && node --import tsx scripts/test-contradictions-ritual.ts && node --import tsx scripts/test-contradictions-history.ts",
    "test:review": "tsx scripts/test-review.ts",
    "test:workflow": "tsx scripts/test-workflow.ts",
    "test:flows": "tsx scripts/test-flows.ts",
    "test:releases": "tsx scripts/test-releases.ts",
    "test:channels": "node --import tsx scripts/test-release-channels.ts",
    "test:promote": "node --import tsx scripts/test-release-promote.ts",
    "test:beta": "node --import tsx scripts/test-release-beta.ts",
    "test:release-stop": "node --import tsx scripts/test-release-stop.ts",
    "test:release-repo": "node --import tsx scripts/test-release-repo.ts",
    "test:offices": "tsx scripts/test-offices.ts",
    "test:archiveboot": "node --import tsx scripts/test-office-archive-boot.ts",
    "test:setup": "tsx scripts/test-setup.ts",
    "test:doctemplates": "node --import tsx scripts/test-doc-templates.ts",
    "test:presets": "tsx scripts/test-presets.ts",
    "test:terminal": "tsx scripts/test-terminal.ts",
    "presets:catalog": "tsx scripts/presets-catalog.ts",
    "restart": "bash scripts/restart-server.sh",
    "test:pm": "bash scripts/run-pm-tests.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.280",
    "@anthropic-ai/sdk": "^0.117.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tabler/icons-react": "^3.46.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "1.2.0-beta.15",
    "playwright-core": "^1.63.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "ws": "^8.21.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^6.4.3"
  }
}
