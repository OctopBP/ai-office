{
  "name": "ai-office",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:3d": "concurrently -n server,web -c cyan,magenta \"OFFICE_PORT=3002 OFFICE_STATE_FILE=.office/state-3d.json tsx watch src/server/index.ts\" \"VITE_OFFICE_PORT=3002 vite --port 5174 --strictPort\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "office": "bash scripts/office.sh",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "probe": "tsx scripts/probe.ts",
    "scene": "bash scripts/scene.sh",
    "scene:check": "python3 tools/blender/inspect_glb.py",
    "test:perm": "tsx scripts/test-permissions.ts",
    "test:state": "tsx scripts/test-state.ts",
    "test:plan": "tsx scripts/test-plan.ts",
    "test:merge": "tsx scripts/test-merge.ts",
    "test:review": "tsx scripts/test-review.ts",
    "test:offices": "tsx scripts/test-offices.ts",
    "restart": "bash scripts/restart-server.sh",
    "test:pm": "bash scripts/run-pm-tests.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.234",
    "@anthropic-ai/sdk": "^0.117.1",
    "@tabler/icons-react": "^3.46.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "ws": "^8.21.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^6.4.3"
  }
}
